rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Credenciales/cookies cifradas del scraper: solo accesibles desde Cloud Functions (Admin SDK).
    match /scraper_sessions/{uid} {
      allow read, write: if false;
    }

    match /batches/{document=**} {
      allow read, write: if true;
    }
    match /scout_members/{document=**} {
      allow read, write: if true;
    }
    match /regions/{document=**} {
      allow read, write: if true;
    }
    match /districts/{document=**} {
      allow read, write: if true;
    }
    match /groups/{document=**} {
      allow read, write: if true;
    }
    match /recognition_types/{document=**} {
      allow read, write: if true;
    }
  }
}
